# bot-block.conf — Apache-level IP blocking for egregious single-IP offenders
# Managed by Ansible. Do not edit this file manually on the server.
#
# UA-based bot blocking is handled in Django by BotBlockingMiddleware
# (regluit PR #1094). This file is for IPs that warrant pre-WSGI rejection,
# e.g. a single IP generating hundreds of thousands of requests per day.
#
# To add/remove IPs: edit blocked_ips in group_vars/<env>/vars.yml and
# re-run the Ansible playbook.

{% if blocked_ips is defined and blocked_ips | length > 0 %}
<Location />
    <RequireAll>
        Require all granted
{% for ip in blocked_ips %}
        Require not ip {{ ip }}
{% endfor %}
    </RequireAll>
</Location>
{% endif %}
