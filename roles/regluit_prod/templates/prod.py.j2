# settings/local.py exists to override things per box, so it can also set
# EMAIL_BACKEND -- after common.py installed the safety net. Fail loudly at
# import rather than mail real users from a staging box. (regluit#1238.)
from regluit.utils.safe_email_backend import ALLOWLIST_BACKEND_PATH
if EMAIL_BACKEND != ALLOWLIST_BACKEND_PATH:
    raise ImproperlyConfigured(
        "EMAIL_SAFE_MODE is on but EMAIL_BACKEND is %r, not the allowlist "
        "backend. Something after 'from .common import *' -- most likely "
        "settings/local.py -- overrode it, which would let mail reach real "
        "users from a non-production box." % (EMAIL_BACKEND,)
    )
