BASE_URL_SECURE = 'https://{{ server_name }}'

LOGGING = {
    'version': 1,
    'disable_existing_loggers': True,
    'formatters': {
        'brief': {
            'format': '%(asctime)s %(levelname)s %(name)s[%(funcName)s]: %(message)s',
        },
        'dl': {
            'format': '%(asctime)s : %(message)s',
        },
    },
    'handlers': {
        'mail_admins': {
            'level': 'ERROR',
            'class': 'django.utils.log.AdminEmailHandler'
        },
        'null': {
            'level': 'DEBUG',
            'class': 'logging.NullHandler',
        },
        'file': {
            'level': 'INFO',
            'class': 'logging.handlers.GroupWriteRotatingFileHandler',
            'filename': join('/var/log/regluit', 'unglue.it.log'),
            'maxBytes': 1024*1024*5, # 5 MB
            'backupCount': 5,
            'formatter': 'brief',
        },
        'downloads': {
            'level': 'INFO',
            'class': 'logging.handlers.GroupWriteRotatingFileHandler',
            'filename': join('/var/log/regluit', 'downloads.log'),
            'maxBytes': 1024*1024*20, # 20 MB
            'backupCount': 9,
            'formatter': 'dl',
        },
    },
    'loggers': {
        'django.request': {
            'handlers': ['mail_admins'],
            'level': 'ERROR',
            'propagate': True,
        },
        'django.security.DisallowedHost': {
            'handlers': ['null'],
            'propagate': False,
        },
        'regluit.downloads': {
            'handlers': ['downloads'],
            'level': 'INFO',
            'propagate': False,
        },
        '': {
            'handlers': ['file'],
            'level': 'WARNING',
            'propagate': False,
        },
{% if email_safe_mode | bool %}
        # This LOGGING dict REPLACES the one settings/common.py builds, and
        # disable_existing_loggers is True. regluit.utils.safe_email_backend's
        # logger already exists by now (common.py imports the module), and a
        # '' entry does not rescue it: '' is not a key in loggerDict, so
        # dictConfig never scans for its children and the module logger is
        # disabled. Without this entry the safety net's ERROR line -- the only
        # trace of a refused send, because Celery's send_mail_task swallows the
        # RuntimeError -- goes nowhere, and a blocked email looks like a
        # silently dropped one. Mirrors common.py's own entry, added for
        # exactly this reason on 2026-08-31. (regluit#1238.)
        'regluit.utils.safe_email_backend': {
            'handlers': ['file'],
            'level': 'ERROR',
            'propagate': False,
        },
{% endif %}
    }
}

