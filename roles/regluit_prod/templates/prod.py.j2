from django.core.exceptions import ImproperlyConfigured
{% if email_safe_mode | bool %}
# Non-production email safety net (regluit#1238). settings/common.py reads
# these from the environment when it is imported on the next line, so setting
# them here covers both mod_wsgi and celery, which both load this module.
# Do NOT set EMAIL_BACKEND in this file, and do not let settings/local.py set
# it either: that would silently undo the net. The assertion at the bottom of
# this file, after the local.py import, is what catches it.
# Values go through to_json so an apostrophe in an address or domain cannot
# produce a prod.py that fails to import.
import os
os.environ['EMAIL_SAFE_MODE'] = 'true'
os.environ['EMAIL_SAFE_MODE_ALLOWED_DOMAINS'] = {{ email_safe_mode_allowed_domains | to_json }}
os.environ['EMAIL_SAFE_MODE_ALLOWED_ADDRESSES'] = {{ email_safe_mode_allowed_addresses | to_json }}
os.environ['EMAIL_SAFE_MODE_REDIRECT_TO'] = {{ email_safe_mode_redirect_to | to_json }}
{% endif %}
